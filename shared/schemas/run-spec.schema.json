{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/legal-case-os/run-spec.schema.json",
  "title": "Legal Case OS transient RunSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "recipe", "task_type", "primary_skill", "execution_status",
    "required_inputs", "required_artifacts", "allowed_tools", "forbidden_tools",
    "capability_requirements", "coverage_rules", "validators", "stop_conditions",
    "human_review_points", "completion_contract", "external_actions_allowed",
    "case_memory_commit_allowed", "preference_memory_commit_allowed", "verification_result"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^RS-[A-Za-z0-9_-]+$" },
    "recipe": { "enum": ["quick", "standard", "deep", "discuss"] },
    "task_type": { "type": "string", "minLength": 1 },
    "primary_skill": { "type": ["string", "null"] },
    "execution_status": { "enum": ["ready", "preview_ready", "awaiting_clarification", "blocked"] },
    "required_inputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "required_artifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "allowed_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "local_read",
          "configured_library_read",
          "case_state_read",
          "verified_public_web_read",
          "local_derived_write"
        ]
      }
    },
    "forbidden_tools": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "capability_requirements": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "coverage_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirement"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "requirement": { "type": "string", "minLength": 1 }
        }
      }
    },
    "validators": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "stop_conditions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "human_review_points": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "completion_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deliverable", "must_report"],
      "properties": {
        "deliverable": { "type": "string", "minLength": 1 },
        "must_report": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "workflow_phases": {
      "description": "Ordered execution phases; composite generation places authority verification before drafting.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "external_actions_allowed": { "const": false },
    "case_memory_commit_allowed": { "const": false },
    "preference_memory_commit_allowed": { "const": false },
    "verification_result": { "type": ["object", "null"] }
  }
}
