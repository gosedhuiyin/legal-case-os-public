{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/legal-case-os/composition-spec.schema.json",
  "title": "Legal Case OS v1.2 CompositionSpec",
  "description": "Persistent multi-template, claim/source, authority, risk, and dependency contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "matter_id", "document_type", "audience", "test_mode",
    "document_goal", "relief_or_position", "procedural_requirements",
    "requested_template_refs", "template_roles", "template_selection_reasons", "pairwise_conflict_assessments", "template_conflict_batch", "template_qualifications", "unresolved_template_refs",
    "ambiguous_template_refs", "trusted_binding", "claim_bindings", "authority_ids",
    "gate_snapshots", "requires_deep_analysis", "dangerous_issues", "section_bindings",
    "adverse_treatments", "risk_conflicts", "dependencies",
    "dependent_artifact_ids", "status", "blockers", "stale", "stale_reason",
    "created_at", "validated_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/Identifier" },
    "matter_id": { "oneOf": [{ "$ref": "#/$defs/Identifier" }, { "type": "null" }] },
    "document_type": { "type": "string", "minLength": 1 },
    "audience": { "enum": ["discussion", "internal_review", "court_candidate"] },
    "test_mode": { "type": "boolean" },
    "document_goal": { "type": ["string", "null"] },
    "relief_or_position": { "type": ["string", "null"] },
    "procedural_requirements": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "requested_template_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "template_roles": { "$ref": "#/$defs/TemplateRoles" },
    "template_selection_reasons": { "type": "array", "items": { "$ref": "#/$defs/TemplateSelectionReason" } },
    "pairwise_conflict_assessments": { "type": "array", "items": { "$ref": "#/$defs/TemplateConflictAssessment" } },
    "template_conflict_batch": { "$ref": "#/$defs/TemplateConflictBatch" },
    "template_qualifications": { "type": "array", "items": { "$ref": "#/$defs/TemplateQualification" } },
    "unresolved_template_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "ambiguous_template_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "trusted_binding": { "$ref": "#/$defs/TrustedBinding" },
    "gate_snapshots": { "$ref": "#/$defs/GateSnapshots" },
    "requires_deep_analysis": { "type": "boolean" },
    "dangerous_issues": { "type": "array", "items": { "$ref": "#/$defs/DangerousIssue" } },
    "section_bindings": { "type": "array", "items": { "$ref": "#/$defs/SectionBinding" } },
    "claim_bindings": { "type": "array", "items": { "$ref": "#/$defs/ClaimBinding" } },
    "authority_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Identifier" } },
    "adverse_treatments": { "type": "array", "items": { "$ref": "#/$defs/AdverseTreatment" } },
    "risk_conflicts": { "type": "array", "items": { "$ref": "#/$defs/RiskConflict" } },
    "dependencies": { "type": "array", "items": { "$ref": "#/$defs/DependencySnapshot" } },
    "dependent_artifact_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Identifier" } },
    "status": { "enum": ["draft", "validated", "ready", "blocked", "stale"] },
    "blockers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "stale": { "type": "boolean" },
    "stale_reason": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "validated_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "$defs": {
    "Identifier": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[A-Za-z0-9._-]+$" },
    "Sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "TemplateRoles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_template_id", "structure_template_id", "auxiliary_templates"],
      "properties": {
        "layout_template_id": { "oneOf": [{ "$ref": "#/$defs/Identifier" }, { "type": "null" }] },
        "structure_template_id": { "oneOf": [{ "$ref": "#/$defs/Identifier" }, { "type": "null" }] },
        "auxiliary_templates": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["template_id", "section_targets"],
            "properties": {
              "template_id": { "$ref": "#/$defs/Identifier" },
              "section_targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "TemplateQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_id", "roles", "approved_final", "authorization", "template_version", "template_hash", "profile", "visual_baseline"],
      "properties": {
        "template_id": { "$ref": "#/$defs/Identifier" },
        "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["layout_primary", "structure_primary", "auxiliary"] } },
        "approved_final": { "type": "boolean" },
        "authorization": {
          "type": "object", "additionalProperties": false, "required": ["status", "basis"],
          "properties": { "status": { "type": ["string", "null"] }, "basis": { "type": ["string", "null"] } }
        },
        "template_version": { "type": ["string", "integer", "null"] },
        "template_hash": { "oneOf": [{ "$ref": "#/$defs/Sha256" }, { "type": "null" }] },
        "profile": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "version", "hash", "status", "fingerprint_manifest_hash", "fingerprint_count", "approval"],
          "properties": {
            "id": { "oneOf": [{ "$ref": "#/$defs/Identifier" }, { "type": "null" }] },
            "version": { "type": ["string", "integer", "null"] },
            "hash": { "oneOf": [{ "$ref": "#/$defs/Sha256" }, { "type": "null" }] },
            "status": { "type": ["string", "null"] },
            "fingerprint_manifest_hash": { "oneOf": [{ "$ref": "#/$defs/Sha256" }, { "type": "null" }] },
            "fingerprint_count": { "type": ["integer", "null"], "minimum": 0 },
            "approval": {
              "type": "object", "additionalProperties": false, "required": ["status", "approval_id", "approved_at"],
              "properties": {
                "status": { "type": ["string", "null"] },
                "approval_id": { "oneOf": [{ "$ref": "#/$defs/Identifier" }, { "type": "null" }] },
                "approved_at": { "type": ["string", "null"], "format": "date-time" }
              }
            }
          }
        },
        "visual_baseline": {
          "type": "object", "additionalProperties": false, "required": ["id", "hash", "status"],
          "properties": {
            "id": { "oneOf": [{ "$ref": "#/$defs/Identifier" }, { "type": "null" }] },
            "hash": { "oneOf": [{ "$ref": "#/$defs/Sha256" }, { "type": "null" }] },
            "status": { "type": ["string", "null"] }
          }
        }
      }
    },
    "TemplateSelectionReason": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "template_id", "mode", "score", "priority", "section_targets", "reason"],
      "properties": {
        "role": { "enum": ["layout_primary", "structure_primary", "auxiliary"] },
        "template_id": { "$ref": "#/$defs/Identifier" },
        "mode": { "type": "string", "minLength": 1 },
        "score": { "type": "number" }, "priority": { "type": "number" },
        "section_targets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "TemplateConflictAssessment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "template_ids", "severity", "affects", "reason", "status", "resolution"],
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "template_ids": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/Identifier" } },
        "severity": { "enum": ["none", "style", "material"] },
        "affects": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["claim", "position", "evidence_use", "authority", "external_risk", "style_only"] } },
        "reason": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pending", "resolved"] },
        "resolution": { "type": ["string", "null"] }
      }
    },
    "TemplateConflictBatch": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "assessment_ids", "assessment_hash", "status", "approval_id", "resolution"],
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "assessment_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Identifier" } },
        "assessment_hash": { "$ref": "#/$defs/Sha256" },
        "status": { "enum": ["not_required", "pending", "approved"] },
        "approval_id": { "oneOf": [{ "$ref": "#/$defs/Identifier" }, { "type": "null" }] },
        "resolution": { "type": ["string", "null"] }
      }
    },
    "TrustedBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "catalog_path", "catalog_sha256", "matter_id",
        "case_projection_sha256", "template_bindings", "authority_bindings", "approval_bindings", "bound_at"
      ],
      "properties": {
        "mode": { "enum": ["unbound", "test_only_fixture", "catalog_case_state"] },
        "catalog_path": { "type": ["string", "null"] },
        "catalog_sha256": { "oneOf": [{ "$ref": "#/$defs/Sha256" }, { "type": "null" }] },
        "matter_id": { "oneOf": [{ "$ref": "#/$defs/Identifier" }, { "type": "null" }] },
        "case_projection_sha256": { "oneOf": [{ "$ref": "#/$defs/Sha256" }, { "type": "null" }] },
        "template_bindings": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["template_id", "catalog_entry_sha256", "template_sha256", "profile_sha256", "visual_baseline_sha256", "fingerprint_manifest_sha256", "fingerprint_count"],
            "properties": {
              "template_id": { "$ref": "#/$defs/Identifier" },
              "catalog_entry_sha256": { "$ref": "#/$defs/Sha256" },
              "template_sha256": { "$ref": "#/$defs/Sha256" },
              "profile_sha256": { "$ref": "#/$defs/Sha256" },
              "visual_baseline_sha256": { "$ref": "#/$defs/Sha256" },
              "fingerprint_manifest_sha256": { "$ref": "#/$defs/Sha256" },
              "fingerprint_count": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "authority_bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["authority_id", "version", "authority_sha256"],
            "properties": {
              "authority_id": { "$ref": "#/$defs/Identifier" },
              "version": { "type": "integer", "minimum": 1 },
              "authority_sha256": { "$ref": "#/$defs/Sha256" }
            }
          }
        },
        "approval_bindings": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["gate", "approval_id", "object_id", "object_hash", "scope_hash"],
            "properties": {
              "gate": { "enum": ["G1_strategy", "G2_evidence"] },
              "approval_id": { "$ref": "#/$defs/Identifier" },
              "object_id": { "$ref": "#/$defs/Identifier" },
              "object_hash": { "$ref": "#/$defs/Sha256" },
              "scope_hash": { "$ref": "#/$defs/Sha256" }
            }
          }
        },
        "bound_at": { "type": "string", "format": "date-time" }
      }
    },
    "GateSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["approval_id", "object_id", "version", "object_hash", "scope_hash", "decision", "status", "approved_source_ids"],
      "properties": {
        "approval_id": { "$ref": "#/$defs/Identifier" },
        "object_id": { "$ref": "#/$defs/Identifier" },
        "version": { "type": "integer", "minimum": 1 },
        "object_hash": { "$ref": "#/$defs/Sha256" },
        "scope_hash": { "$ref": "#/$defs/Sha256" },
        "decision": { "enum": ["approved", "rejected", "revoked", "pending"] },
        "status": { "enum": ["active", "stale", "pending"] },
        "approved_source_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Identifier" } }
      }
    },
    "GateSnapshots": {
      "type": "object", "additionalProperties": false,
      "required": ["G1_strategy", "G2_evidence"],
      "properties": {
        "G1_strategy": { "oneOf": [{ "$ref": "#/$defs/GateSnapshot" }, { "type": "null" }] },
        "G2_evidence": { "oneOf": [{ "$ref": "#/$defs/GateSnapshot" }, { "type": "null" }] }
      }
    },
    "DangerousIssue": {
      "type": "object", "additionalProperties": false,
      "required": ["issue_id", "title", "risk_level", "analysis_artifact_id", "analysis_version", "analysis_hash", "status", "adverse_path_covered"],
      "properties": {
        "issue_id": { "$ref": "#/$defs/Identifier" }, "title": { "type": "string", "minLength": 1 },
        "risk_level": { "enum": ["high", "critical"] }, "analysis_artifact_id": { "$ref": "#/$defs/Identifier" },
        "analysis_version": { "type": ["string", "integer"] }, "analysis_hash": { "$ref": "#/$defs/Sha256" },
        "status": { "enum": ["pending", "completed", "stale"] }, "adverse_path_covered": { "type": "boolean" }
      }
    },
    "SectionBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["section_id", "purpose", "template_id", "claim_ids", "authority_ids"],
      "properties": {
        "section_id": { "type": "string", "minLength": 1 }, "purpose": { "type": "string", "minLength": 1 },
        "template_id": { "$ref": "#/$defs/Identifier" },
        "claim_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Identifier" } },
        "authority_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Identifier" } }
      }
    },
    "ClaimBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "proposition", "proposition_sha256", "proposition_basis_sha256", "claim_type", "fact_ids", "fact_bindings", "source_ids", "evidence_ids", "evidence_bindings", "source_locators", "authority_ids", "authority_locators", "court_candidate", "verification_status"],
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "proposition": { "type": "string", "minLength": 1 },
        "proposition_sha256": { "$ref": "#/$defs/Sha256" },
        "proposition_basis_sha256": { "$ref": "#/$defs/Sha256" },
        "claim_type": { "enum": ["fact", "law", "mixed"] },
        "fact_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Identifier" } },
        "fact_bindings": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["fact_id", "version", "fact_sha256", "statement_sha256", "proposition_sha256", "source_record_sha256s"],
            "properties": {
              "fact_id": { "$ref": "#/$defs/Identifier" }, "version": { "type": "integer", "minimum": 1 },
              "fact_sha256": { "$ref": "#/$defs/Sha256" }, "statement_sha256": { "$ref": "#/$defs/Sha256" },
              "proposition_sha256": { "$ref": "#/$defs/Sha256" },
              "source_record_sha256s": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Sha256" } }
            }
          }
        },
        "source_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Identifier" } },
        "evidence_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Identifier" } },
        "evidence_bindings": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["evidence_id", "version", "evidence_sha256", "proposition_sha256", "source_record_sha256s"],
            "properties": {
              "evidence_id": { "$ref": "#/$defs/Identifier" }, "version": { "type": "integer", "minimum": 1 },
              "evidence_sha256": { "$ref": "#/$defs/Sha256" }, "proposition_sha256": { "$ref": "#/$defs/Sha256" },
              "source_record_sha256s": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Sha256" } }
            }
          }
        },
        "source_locators": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["source_id", "locator", "record_kind", "verified", "record_sha256"],
            "properties": {
              "source_id": { "$ref": "#/$defs/Identifier" }, "locator": { "type": "string", "minLength": 1 },
              "record_kind": { "enum": ["direct_record", "user_statement", "model_inference"] }, "verified": { "type": "boolean" },
              "record_sha256": { "$ref": "#/$defs/Sha256" }, "quote_sha256": { "$ref": "#/$defs/Sha256" },
              "fact_id": { "$ref": "#/$defs/Identifier" }, "fact_sha256": { "$ref": "#/$defs/Sha256" }
            }
          }
        },
        "authority_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Identifier" } },
        "authority_locators": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["authority_id", "locator", "citation", "verified", "holding_sha256"],
            "properties": {
              "authority_id": { "$ref": "#/$defs/Identifier" }, "locator": { "type": "string", "minLength": 1 },
              "citation": { "type": "string", "minLength": 1 }, "verified": { "type": "boolean" },
              "holding_sha256": { "$ref": "#/$defs/Sha256" }
            }
          }
        },
        "court_candidate": { "type": "boolean" },
        "verification_status": { "enum": ["verified", "partially_verified", "unverified", "blocked"] }
      }
    },
    "AdverseTreatment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_id", "disposition", "analysis", "status"],
      "properties": {
        "authority_id": { "$ref": "#/$defs/Identifier" },
        "disposition": { "enum": ["disclose", "distinguish", "accept"] },
        "analysis": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pending", "resolved"] }
      }
    },
    "RiskConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "affects", "severity", "status", "description", "resolution"],
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "affects": { "enum": ["claim", "position", "evidence_use", "authority", "external_risk", "style_only"] },
        "severity": { "enum": ["minor", "material"] },
        "status": { "enum": ["open", "resolved"] },
        "description": { "type": "string", "minLength": 1 },
        "resolution": { "type": ["string", "null"] }
      }
    },
    "DependencySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "object_type", "version", "hash", "required"],
      "properties": {
        "object_id": { "$ref": "#/$defs/Identifier" },
        "object_type": { "enum": ["template", "profile", "visual_baseline", "source", "fact", "issue", "evidence", "authority", "decision", "artifact", "approval"] },
        "version": { "type": ["integer", "string"] },
        "hash": { "$ref": "#/$defs/Sha256" },
        "required": { "type": "boolean" }
      }
    }
  }
}
