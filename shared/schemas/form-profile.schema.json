{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/legal-case-os/form-profile.schema.json",
  "title": "Legal Case OS FormProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "engine_version", "profile_kind", "profile_id", "template_id",
    "name", "document_type", "usage_mode", "status", "distilled_at", "source",
    "layout", "package_contract", "visual_baseline", "unresolved_items", "slots",
    "empty_cell_decisions", "blocked_exemplar_text_sha256"
  ],
  "properties": {
    "test_only": { "type": "boolean" },
    "notice": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "engine_version": { "const": "1.2.0" },
    "profile_kind": { "const": "form" },
    "profile_id": { "type": "string", "minLength": 1 },
    "template_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "document_type": { "type": "string", "minLength": 1 },
    "usage_mode": { "enum": ["reference", "fillable_clone", "hybrid"] },
    "status": { "enum": ["draft", "active", "retired"] },
    "distilled_at": { "type": "string", "format": "date-time" },
    "activated_at": { "type": "string", "format": "date-time" },
    "approval": { "$ref": "#/$defs/approval" },
    "retired_at": { "type": "string", "format": "date-time" },
    "retirement_approval": { "$ref": "#/$defs/approval" },
    "source": { "$ref": "#/$defs/source" },
    "layout": { "$ref": "#/$defs/layout" },
    "package_contract": { "$ref": "#/$defs/packageContract" },
    "visual_baseline": { "$ref": "#/$defs/visualBaseline" },
    "unresolved_items": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "slots": {
      "type": "array",
      "items": { "$ref": "#/$defs/slot" }
    },
    "empty_cell_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["part", "path", "action", "reason"],
        "properties": {
          "part": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "action": { "enum": ["not_fillable", "manual_blank"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blocked_exemplar_text_sha256": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "uniqueItems": true
    },
    "repeatable_blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/repeatableBlock" }
    }
  },
  "$defs": {
    "approval": {
      "type": "object",
      "additionalProperties": true,
      "required": ["confirmed", "approved_by", "decision_id"],
      "properties": {
        "confirmed": { "const": true },
        "approved_by": { "type": "string", "minLength": 1 },
        "decision_id": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "suffix", "read_only_verified", "package_inventory_sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "suffix": { "const": ".docx" },
        "read_only_verified": { "const": true },
        "package_inventory_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paragraph_count", "table_count", "section_count", "text_node_count",
        "unanchored_empty_table_cells"
      ],
      "properties": {
        "paragraph_count": { "type": "integer", "minimum": 0 },
        "table_count": { "type": "integer", "minimum": 0 },
        "section_count": { "type": "integer", "minimum": 0 },
        "text_node_count": { "type": "integer", "minimum": 0 },
        "unanchored_empty_table_cells": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["part", "path"],
            "properties": {
              "part": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "inventoryPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "sha256", "structure_sha256", "compression"],
      "properties": {
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "structure_sha256": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        },
        "compression": { "type": "integer", "minimum": 0 }
      }
    },
    "packageContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parts", "editable_parts", "preserve_only_parts"],
      "properties": {
        "parts": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/inventoryPart" }
        },
        "editable_parts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "preserve_only_parts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "visualBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_sha256", "renderer", "page_count", "pages", "reviewed_by", "reviewed_at"],
      "properties": {
        "status": { "enum": ["pending", "verified"] },
        "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "renderer": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "page_count": { "type": "integer", "minimum": 0 },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page_number", "path", "sha256"],
            "properties": {
              "page_number": { "type": "integer", "minimum": 1 },
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "reviewed_by": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "reviewed_at": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part", "path", "text_node_index", "expected_text_sha256"],
      "properties": {
        "part": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "text_node_index": { "type": "integer", "minimum": 1 },
        "expected_text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id", "field_key", "locator", "policy", "policy_suggestion",
        "policy_review_required", "placeholder_kind", "source_text_length", "condition",
        "content_role", "block_original_text_in_output"
      ],
      "properties": {
        "slot_id": { "type": "string", "minLength": 1 },
        "field_key": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "locator": { "$ref": "#/$defs/locator" },
        "policy": {
          "oneOf": [
            {
              "enum": [
                "fixed_locked", "required_verified", "conditional_verified", "optional_verified",
                "derived_needs_confirmation", "lawyer_decision_required", "manual_blank", "repeatable"
              ]
            },
            { "type": "null" }
          ]
        },
        "policy_suggestion": {
          "oneOf": [
            {
              "enum": [
                "fixed_locked", "required_verified", "conditional_verified", "optional_verified",
                "derived_needs_confirmation", "lawyer_decision_required", "manual_blank", "repeatable"
              ]
            },
            { "type": "null" }
          ]
        },
        "policy_review_required": { "type": "boolean" },
        "placeholder_kind": {
          "oneOf": [
            { "enum": ["mustache", "brackets", "underline"] },
            { "type": "null" }
          ]
        },
        "source_text_length": { "type": "integer", "minimum": 0 },
        "condition": {},
        "content_role": {
          "enum": ["field_anchor", "unreviewed_fixed_content", "template_boilerplate", "case_specific_blocked"]
        },
        "block_original_text_in_output": { "type": "boolean" }
        ,"repeatable_block_id": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        }
      }
    },
    "repeatableItemSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_slot_id", "field_key", "text_node_index", "expected_text_sha256", "policy", "max_chars"],
      "properties": {
        "item_slot_id": { "type": "string", "minLength": 1 },
        "field_key": { "type": "string", "minLength": 1 },
        "text_node_index": { "type": "integer", "minimum": 1 },
        "expected_text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "policy": {
          "enum": ["required_verified", "conditional_verified", "optional_verified", "derived_needs_confirmation", "lawyer_decision_required", "manual_blank"]
        },
        "max_chars": { "type": "integer", "minimum": 1, "maximum": 4000 },
        "sequence": { "type": "boolean" }
      }
    },
    "repeatableBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id", "part", "container_path", "prototype_row_path", "prototype_row_sha256",
        "prototype_text_node_count", "fixed_text_nodes", "item_slots", "min_items", "max_items"
      ],
      "properties": {
        "block_id": { "type": "string", "minLength": 1 },
        "part": { "const": "word/document.xml" },
        "container_path": { "type": "string", "minLength": 1 },
        "prototype_row_path": { "type": "string", "minLength": 1 },
        "prototype_row_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "prototype_text_node_count": { "type": "integer", "minimum": 1 },
        "fixed_text_nodes": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["text_node_index", "expected_text_sha256"],
            "properties": {
              "text_node_index": { "type": "integer", "minimum": 1 },
              "expected_text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "item_slots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/repeatableItemSlot" } },
        "min_items": { "type": "integer", "minimum": 0 },
        "max_items": { "type": "integer", "minimum": 1, "maximum": 100 },
        "blocked_text_sha256": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
