{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/legal-case-os/writing-profile.schema.json",
  "title": "Legal Case OS WritingProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "engine_version", "profile_kind", "profile_id", "template_id",
    "name", "document_type", "usage_mode", "status", "distilled_at", "source",
    "layout", "package_contract", "visual_baseline", "unresolved_items", "metrics", "structure_outline",
    "format_metrics", "argument_profile", "curated_features", "transfer_policy",
    "boundary_candidates", "body_boundaries"
  ],
  "properties": {
    "test_only": { "type": "boolean" },
    "notice": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "engine_version": { "const": "1.2.0" },
    "profile_kind": { "const": "writing" },
    "profile_id": { "type": "string", "minLength": 1 },
    "template_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "document_type": { "type": "string", "minLength": 1 },
    "usage_mode": { "enum": ["reference", "hybrid"] },
    "status": { "enum": ["draft", "active", "retired"] },
    "distilled_at": { "type": "string", "format": "date-time" },
    "activated_at": { "type": "string", "format": "date-time" },
    "approval": { "type": "object" },
    "retired_at": { "type": "string", "format": "date-time" },
    "retirement_approval": { "type": "object" },
    "source": { "$ref": "#/$defs/source" },
    "layout": { "$ref": "#/$defs/layout" },
    "package_contract": { "$ref": "#/$defs/packageContract" },
    "visual_baseline": { "$ref": "#/$defs/visualBaseline" },
    "unresolved_items": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paragraph_count", "nonempty_paragraph_count", "total_character_count",
        "average_nonempty_paragraph_length", "style_counts", "alignment_counts",
        "bold_run_ratio", "citation_marker_count", "sentence_marker_count"
      ],
      "properties": {
        "paragraph_count": { "type": "integer", "minimum": 0 },
        "nonempty_paragraph_count": { "type": "integer", "minimum": 0 },
        "total_character_count": { "type": "integer", "minimum": 0 },
        "average_nonempty_paragraph_length": { "type": "number", "minimum": 0 },
        "style_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "alignment_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "bold_run_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "citation_marker_count": { "type": "integer", "minimum": 0 },
        "sentence_marker_count": { "type": "integer", "minimum": 0 }
      }
    },
    "structure_outline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paragraph_index", "part", "path", "style_id", "alignment", "character_count",
          "text_sha256", "run_count", "bold_run_count", "sentence_mark_count", "citation_mark_count",
          "role_hint"
        ],
        "properties": {
          "paragraph_index": { "type": "integer", "minimum": 1 },
          "part": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "style_id": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
          "alignment": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
          "character_count": { "type": "integer", "minimum": 0 },
          "text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "run_count": { "type": "integer", "minimum": 0 },
          "bold_run_count": { "type": "integer", "minimum": 0 },
          "sentence_mark_count": { "type": "integer", "minimum": 0 },
          "citation_mark_count": { "type": "integer", "minimum": 0 },
          "role_hint": {
            "enum": ["heading", "centered_heading_candidate", "blank_spacing_or_container", "body"]
          }
        }
      }
    },
    "format_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sections", "tables", "style_catalog", "numbering", "annotations",
        "header_part_count", "footer_part_count"
      ],
      "properties": {
        "sections": { "type": "array", "items": { "type": "object" } },
        "tables": { "type": "array", "items": { "type": "object" } },
        "style_catalog": { "type": "array", "items": { "type": "object" } },
        "numbering": {
          "type": "object",
          "additionalProperties": false,
          "required": ["abstract_definition_count", "instance_count"],
          "properties": {
            "abstract_definition_count": { "type": "integer", "minimum": 0 },
            "instance_count": { "type": "integer", "minimum": 0 }
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "header_part_count": { "type": "integer", "minimum": 0 },
        "footer_part_count": { "type": "integer", "minimum": 0 }
      }
    },
    "argument_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["marker_counts", "sentence_count", "average_sentence_length", "max_sentence_length"],
      "properties": {
        "marker_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sequence", "contrast", "conclusion", "counterargument", "evidence_link", "authority_link"],
          "properties": {
            "sequence": { "type": "integer", "minimum": 0 },
            "contrast": { "type": "integer", "minimum": 0 },
            "conclusion": { "type": "integer", "minimum": 0 },
            "counterargument": { "type": "integer", "minimum": 0 },
            "evidence_link": { "type": "integer", "minimum": 0 },
            "authority_link": { "type": "integer", "minimum": 0 }
          }
        },
        "sentence_count": { "type": "integer", "minimum": 0 },
        "average_sentence_length": { "type": "number", "minimum": 0 },
        "max_sentence_length": { "type": "integer", "minimum": 0 }
      }
    },
    "curated_features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_functions", "argument_pattern", "voice_rules", "annotation_rules", "length_rules"],
      "properties": {
        "section_functions": { "$ref": "#/$defs/shortRules" },
        "argument_pattern": { "$ref": "#/$defs/shortRules" },
        "voice_rules": { "$ref": "#/$defs/shortRules" },
        "annotation_rules": { "$ref": "#/$defs/shortRules" },
        "length_rules": { "$ref": "#/$defs/shortRules" }
      }
    },
    "composition_preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_score", "structure_score", "auxiliary_score", "priority", "role_suitability", "section_targets", "selection_notes", "compatibility_tags"],
      "properties": {
        "layout_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "structure_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "auxiliary_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "priority": { "type": "number", "minimum": 0, "maximum": 100 },
        "role_suitability": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["layout", "structure", "auxiliary"] } },
        "section_targets": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "selection_notes": { "type": "string" },
        "compatibility_tags": {
          "type": "object", "additionalProperties": false,
          "required": ["relief_or_position", "evidence_use", "authority", "external_risk"],
          "properties": {
            "relief_or_position": { "$ref": "#/$defs/shortRules" },
            "evidence_use": { "$ref": "#/$defs/shortRules" },
            "authority": { "$ref": "#/$defs/shortRules" },
            "external_risk": { "$ref": "#/$defs/shortRules" }
          }
        }
      }
    },
    "boundary_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "locator", "character_count"],
        "properties": {
          "candidate_id": { "type": "string", "minLength": 1 },
          "locator": { "$ref": "#/$defs/locator" },
          "character_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "body_boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["boundary_id", "start_candidate_id", "end_candidate_id", "purpose", "replacement_strategy"],
        "properties": {
          "boundary_id": { "type": "string", "minLength": 1 },
          "start_candidate_id": { "type": "string", "minLength": 1 },
          "end_candidate_id": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "replacement_strategy": { "enum": ["single_text_node", "external_docx_composer_required"] }
        }
      }
    },
    "mechanical_slots": {
      "type": "array",
      "items": { "$ref": "#/$defs/mechanicalSlot" }
    },
    "body_regions": {
      "type": "array",
      "items": { "$ref": "#/$defs/bodyRegion" }
    },
    "transfer_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reusable_aspects", "forbidden_transfer"],
      "properties": {
        "reusable_aspects": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "forbidden_transfer": { "type": "array", "items": { "type": "string" }, "minItems": 8, "uniqueItems": true }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "suffix", "read_only_verified", "package_inventory_sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "suffix": { "const": ".docx" },
        "read_only_verified": { "const": true },
        "package_inventory_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paragraph_count", "table_count", "section_count", "text_node_count", "unanchored_empty_table_cells"],
      "properties": {
        "paragraph_count": { "type": "integer", "minimum": 0 },
        "table_count": { "type": "integer", "minimum": 0 },
        "section_count": { "type": "integer", "minimum": 0 },
        "text_node_count": { "type": "integer", "minimum": 0 },
        "unanchored_empty_table_cells": { "type": "array", "items": { "type": "object" } }
      }
    },
    "packageContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parts", "editable_parts", "preserve_only_parts"],
      "properties": {
        "parts": { "type": "object" },
        "editable_parts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "preserve_only_parts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "visualBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_sha256", "renderer", "page_count", "pages", "reviewed_by", "reviewed_at"],
      "properties": {
        "status": { "enum": ["pending", "verified"] },
        "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "renderer": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "page_count": { "type": "integer", "minimum": 0 },
        "pages": { "type": "array", "items": { "type": "object" } },
        "reviewed_by": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "reviewed_at": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part", "path", "text_node_index", "expected_text_sha256"],
      "properties": {
        "part": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "text_node_index": { "type": "integer", "minimum": 1 },
        "expected_text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "mechanicalSlot": {
      "type": "object", "additionalProperties": false,
      "required": ["slot_id", "field_key", "locator", "policy", "max_chars", "block_original_text_in_output"],
      "properties": {
        "slot_id": { "type": "string", "minLength": 1 },
        "field_key": { "type": "string", "minLength": 1 },
        "locator": { "$ref": "#/$defs/locator" },
        "policy": { "enum": ["fixed_locked", "required_verified", "conditional_verified", "optional_verified", "derived_needs_confirmation", "lawyer_decision_required", "manual_blank"] },
        "max_chars": { "type": "integer", "minimum": 1, "maximum": 4000 },
        "block_original_text_in_output": { "type": "boolean" }
      }
    },
    "blockAnchor": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "subtree_sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "subtree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "paragraphRole": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "donor_paragraph_path", "donor_paragraph_sha256", "donor_run_index", "max_chars"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "donor_paragraph_path": { "type": "string", "minLength": 1 },
        "donor_paragraph_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "donor_run_index": { "type": "integer", "minimum": 1 },
        "max_chars": { "type": "integer", "minimum": 1, "maximum": 20000 }
      }
    },
    "bodyRegion": {
      "type": "object", "additionalProperties": false,
      "required": [
        "region_id", "part", "container_path", "start_block_path", "end_block_path",
        "source_block_sha256", "preceding_anchor", "following_anchor", "min_paragraphs",
        "max_paragraphs", "paragraph_roles", "blocked_text_sha256"
      ],
      "properties": {
        "region_id": { "type": "string", "minLength": 1 },
        "part": { "const": "word/document.xml" },
        "container_path": { "type": "string", "minLength": 1 },
        "start_block_path": { "type": "string", "minLength": 1 },
        "end_block_path": { "type": "string", "minLength": 1 },
        "source_block_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "preceding_anchor": { "$ref": "#/$defs/blockAnchor" },
        "following_anchor": { "$ref": "#/$defs/blockAnchor" },
        "min_paragraphs": { "type": "integer", "minimum": 0 },
        "max_paragraphs": { "type": "integer", "minimum": 1, "maximum": 200 },
        "paragraph_roles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/paragraphRole" } },
        "blocked_text_sha256": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
      }
    },
    "shortRules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[^\\r\\n]+$" }
    }
  }
}
